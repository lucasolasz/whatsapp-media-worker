{
  "services": [
    {
      "type": "app",
      "data": {
        "serviceName": "whatsapp-media-worker",
        "source": {
          "type": "github",
          "owner": "lucasolasz",
          "repo": "whatsapp-media-worker",
          "ref": "main",
          "path": "/",
          "autoDeploy": false
        },
        "build": {
          "type": "dockerfile",
          "file": "Dockerfile"
        },
        "env": "SEGREDOS_TOKEN=GERE_UM_SEGREDO\nCORS_ORIGENS=https://ltech-automate-dashboard.vercel.app,http://localhost:3000\nDESTINOS_PERMITIDOS=s3.seudominio.com\nTAMANHO_MAXIMO_MB=100\nRETENCAO_MINUTOS=60",
        "domains": [
          {
            "host": "$(EASYPANEL_DOMAIN)",
            "port": 3000
          }
        ],
        "mounts": [],
        "resources": {
          "memoryReservation": 0,
          "memoryLimit": 1024,
          "cpuReservation": 0,
          "cpuLimit": 0
        }
      }
    }
  ]
}
